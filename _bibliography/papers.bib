@article{noh2026pathclast,
  abbr        = {BIB},
  bibtex_show = {true},
  title       = {{PathCLAST}: pathway-augmented contrastive learning with attention for interpretable spatial transcriptomics},
  author      = {Noh, Minho and Lee, S. and Kim, S. and Lim, S.},
  journal     = {Briefings in Bioinformatics},
  year        = {2026},
  month       = {February},
  publisher   = {Oxford University Press},
  abstract    = {We propose an interpretable AI model that integrates gene expression, histopathology images, and biological prior knowledge (KEGG pathways) for spatial transcriptomics. Pathway-aware multimodal contrastive learning, combined with data augmentation strategies, improves spatial domain clustering accuracy and provides interpretable attention scores at the pathway level. The framework also reveals tumor-stage-specific characteristics and spatial heterogeneity, contributing to personalized treatment strategies.},
  selected    = {true},
}

